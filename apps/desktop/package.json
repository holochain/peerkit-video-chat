{
  "name": "@peerkit-video-chat/desktop",
  "version": "0.0.0",
  "private": true,
  "description": "Electron desktop app for the peerkit-video-chat showcase",
  "author": "Holochain Devs <dev-team@holochain.org>",
  "homepage": "https://github.com/holochain/peerkit-video-chat",
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "build": "tsc --build && electron-vite build",
    "dev": "electron-vite dev",
    "electron:install": "node ../../node_modules/electron/install.js",
    "postinstall": "node ../../node_modules/electron/install.js",
    "start": "electron-vite preview",
    "package": "electron-builder",
    "package:linux": "electron-builder --linux",
    "package:mac": "electron-builder --mac",
    "package:win": "electron-builder --win"
  },
  "dependencies": {
    "@libp2p/logger": "^6.2.12",
    "@logtape/logtape": "^2.3.0",
    "@peerkit/api": "^0.1.0-alpha.14",
    "@peerkit/peerkit": "^0.1.0-alpha.14",
    "electron-store": "^11.0.0"
  },
  "devDependencies": {
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "@peerkit-video-chat/core": "*",
    "@sveltejs/vite-plugin-svelte": "^7.2.0",
    "electron": "^42.3.3",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "svelte": "^5.56.8",
    "vite": "7.3.3"
  }
}
